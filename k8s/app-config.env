# Non-secret app settings for the Kubernetes deployment (namespace rewriter-ia2).
# `.\scripts\demo.ps1 deploy` merges these with the API keys from your local .env
# into the Secret `rewriter-config` (keys are never printed or committed).
# Model chosen by the application AI evaluation (EXP-04): Gemini 3.5 Flash-Lite with prompt V3,
# served by Google AI Studio's free tier (LLM_PROVIDER=google; the OPENROUTER_MODEL name is kept for compatibility).
LLM_PROVIDER=google
OPENROUTER_MODEL=gemini-3.5-flash-lite
OPENROUTER_FALLBACK_MODELS=
PROMPT_VERSION=v3
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=1000
OPENROUTER_TIMEOUT_S=30
