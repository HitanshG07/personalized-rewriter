# Non-secret app settings for the Kubernetes deployment (namespace rewriter-ia2).
# `.\scripts\demo.ps1 deploy` merges these with OPENROUTER_API_KEY from your local .env
# into the Secret `rewriter-config` (the key is never printed or committed).
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
PROMPT_VERSION=v1
TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=1000
OPENROUTER_TIMEOUT_S=30
